{
  "name": "usage-pill",
  "version": "0.2.1",
  "description": "A draggable desktop pill and menu bar app showing your AI plan usage: Claude Code, Ollama Cloud, and more via providers",
  "license": "MIT",
  "author": "Tehseen Ullah",
  "type": "module",
  "main": "src/main.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/core/index.mjs"
    },
    "./providers/*": "./src/core/providers/*.mjs"
  },
  "bin": {
    "usage-pill": "bin/usage-pill.mjs",
    "usage-pill-cli": "bin/usage-pill-cli.mjs"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node bin/usage-pill-cli.mjs",
    "test": "node --test test/*.test.mjs",
    "dist": "electron-builder --mac",
    "release": "node scripts/release.mjs",
    "tray-icon": "node scripts/tray-icon.mjs",
    "app-icon": "node scripts/app-icon.mjs"
  },
  "peerDependencies": {
    "electron": ">=33"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "files": [
    "src",
    "bin",
    "assets",
    "index.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ollama",
    "usage",
    "quota",
    "menubar",
    "widget",
    "electron",
    "statusline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TEHSEENULLAH786/usage-pill.git"
  }
}
